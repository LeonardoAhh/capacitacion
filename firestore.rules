rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===== FUNCIONES AUXILIARES =====
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
       return request.auth != null && getUserData().rol == role;
    }
    
    function hasAnyRole(roles) {
      return request.auth != null && getUserData().rol in roles;
    }
    
    function isNotAnonymous() {
      return request.auth != null && 
             request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isValidString(text) {
      return text is string && text.size() > 0;
    }
    function isValidScore(score) {
      return (score is number && score >= 0 && score <= 100) || score == null;
    }
    function isValidEmail(email) {
      return email is string && email.matches('.*@.*\\..*');
    }
    
    // ===== REGLAS POR COLECCIÓN =====
    
    match /users/{userId} {
      allow read: if isAuthenticated() && 
                 (request.auth.uid == userId || hasAnyRole(['super_admin', 'rh']));
      allow create: if hasRole('super_admin') || 
                  (isAuthenticated() && 
                   request.auth.uid == userId &&
                   request.resource.data.email == request.auth.token.email);
      allow update: if hasAnyRole(['super_admin', 'rh']) || request.auth.uid == userId;
      allow delete: if hasRole('super_admin');

      // ✅ Progreso del usuario en cursos interactivos
      // Ruta: users/{userId}/progress/{courseId}
      match /progress/{courseId} {
        // El usuario solo puede leer y escribir su propio progreso
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }
    
    match /employees/{docId} {
      allow read: if true;
      allow create: if hasAnyRole(['super_admin', 'rh'])
                    && isValidString(request.resource.data.name)
                    && isValidString(request.resource.data.employeeId);
      allow update: if hasAnyRole(['super_admin', 'rh']) ||
                       (isAuthenticated() && 
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['accessCodeUses', 'lastLoginCandidate', 'cursosCompletados', 'coursesProgress', 'avatar', 'theme', 'nickname']));
      allow delete: if hasRole('super_admin');
    }
    
    match /employees_programacion/{docId} {
      allow read: if true;
      allow create: if hasAnyRole(['super_admin', 'rh'])
                    && isValidString(request.resource.data.name)
                    && isValidString(request.resource.data.employeeId)
                    && isValidString(request.resource.data.accessCode);
      allow update: if hasAnyRole(['super_admin', 'rh']) || 
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['avatar', 'theme', 'nickname']);
      allow delete: if hasRole('super_admin');
    }
    
    match /induction_courses/{docId} {
      allow read: if true;
      allow write: if hasAnyRole(['super_admin', 'rh', 'instructor'])
                   && isValidString(request.resource.data.title);
    }
    
    match /cursos_induccion/{docId} {
      allow read: if true;
      allow write: if hasAnyRole(['super_admin', 'rh', 'instructor']);
    }

    match /programacion/{docId} {
      allow read: if true;
      allow create: if hasAnyRole(['super_admin', 'rh']);
      allow update: if hasAnyRole(['super_admin', 'rh']) || isAuthenticated();
      allow delete: if hasAnyRole(['super_admin', 'rh']);
    }
    
    match /positions/{docId} {
      allow read: if true;
      allow write: if hasAnyRole(['super_admin', 'rh'])
                   && isValidString(request.resource.data.name);
    }

    match /datos/{docId} {
      allow read: if isAuthenticated();
      allow write: if hasAnyRole(['super_admin', 'rh']);
    }
    
    match /training_records/{docId} {
      allow read: if true;
      allow write: if hasAnyRole(['super_admin', 'rh'])
                   && isValidString(request.resource.data.name) 
                   && isValidString(request.resource.data.position);
    }
    
    match /skills/{docId} {
      allow read: if isNotAnonymous();
      allow write: if hasAnyRole(['super_admin', 'rh']);
    }
    
    match /training_logs/{docId} {
      allow read: if isNotAnonymous();
      allow write: if hasAnyRole(['super_admin', 'rh']);
    }
    
    match /alerts/{docId} {
      allow read: if isNotAnonymous();
      allow write: if hasAnyRole(['super_admin', 'rh']);
    }
    
    match /calendar_events/{docId} {
      allow read: if isNotAnonymous();
      allow write: if hasAnyRole(['super_admin', 'rh']);
    }
    
    match /promotions/{docId} {
      allow read: if isNotAnonymous();
      allow write: if hasAnyRole(['super_admin', 'rh']);
    }
    
    match /audit_logs/{docId} {
      // Solo super_admin e instructor pueden leer el historial
      allow read: if hasAnyRole(['super_admin', 'instructor']);
      // ✅ Cualquier usuario autenticado puede CREAR entradas (no editar ni borrar)
      allow create: if isAuthenticated();
      allow update, delete: if hasRole('super_admin');
    }
    
    match /exam_questions/{docId} {
      allow read: if isNotAnonymous();
      allow write: if hasAnyRole(['super_admin', 'rh']);
    }

    match /promotion_rules/{docId} {
      allow read: if true;
      allow write: if hasAnyRole(['super_admin', 'rh']);
    }

    match /system_config/{docId} {
      allow read, write: if hasRole('super_admin');
    }

    match /app_config/{docId} {
      allow read: if true;
      allow write: if hasAnyRole(['admin', 'superadmin', 'ADMIN', 'SUPER_ADMIN', 'super_admin']);
    }

    // ===== CURSOS INTERACTIVOS NATIVOS =====
    // ✅ read: true — el portal de training usa sesión propia (sin Firebase Auth)
    //    y necesita leer cursos y slides sin autenticación de Firebase.
    match /cursos/{courseId} {
      allow read: if true;
      allow write: if hasAnyRole(['super_admin', 'instructor']);

      match /slides/{slideId} {
        allow read: if true;
        allow write: if hasAnyRole(['super_admin', 'instructor']);
      }
    }

    // ===== BANCO DE EXÁMENES NATIVO =====
    match /examenes/{examId} {
      // Un candidato logueado solo puede leer si está publicado. Admins pueden leer todos.
      allow read: if isAuthenticated() && (
        resource.data.status == 'published' || hasAnyRole(['super_admin', 'admin', 'instructor', 'Instructor', 'rh'])
      );
      // Solo roles administrativos pueden crear, modificar o eliminar exámenes
      allow write: if hasAnyRole(['super_admin', 'admin', 'instructor', 'Instructor', 'rh']);
    }

    // Historial auditable de exámenes (snapshots)
    match /exam_history/{historyId} {
      allow read, write: if hasAnyRole(['super_admin', 'admin', 'instructor', 'Instructor', 'rh']);
    }
    
    match /employees/{empId}/exam_results/{resultId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ===== MURAL DE RECONOCIMIENTO =====
    match /mural_exams/{employeeId} {
      // Público puede visualizar solo si conoce el ID puntual
      allow get: if true;
      // Administradores pueden listar los registros en el panel de administración
      allow list: if hasAnyRole(['super_admin', 'admin', 'rh']);
      // Solo administradores pueden crear, editar o eliminar registros públicos
      allow write: if hasAnyRole(['super_admin', 'admin', 'rh']);
    }

    match /roles/{roleId} {
      allow read: if hasAnyRole(['super_admin', 'admin', 'rh']);
      allow create, update, delete: if hasAnyRole(['super_admin', 'rh']);
    }
    
    // ===== GRUPOS Y CERTIFICACIONES (Auditores, Brigadas, etc.) =====
    match /groups/{docId} {
      allow read: if isAuthenticated();
      allow create: if hasAnyRole(['super_admin', 'rh'])
                    && isValidString(request.resource.data.name);
      allow update: if hasAnyRole(['super_admin', 'rh'])
                    && isValidString(request.resource.data.name);
      allow delete: if hasAnyRole(['super_admin', 'rh']);
    }

    // ===== REGLA POR DEFECTO (FALLBACK) =====
    match /{document=**} {
      allow read: if isNotAnonymous();
      allow write: if hasRole('super_admin');
    }
  }
}
