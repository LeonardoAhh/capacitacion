rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===== FUNCIONES AUXILIARES =====
    
    // Obtener datos del usuario autenticado
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Verificar si el usuario tiene un rol específico
    function hasRole(role) {
       return request.auth != null && getUserData().rol == role;
    }
    
    // Verificar múltiples roles permitidos
    function hasAnyRole(roles) {
      return request.auth != null && getUserData().rol in roles;
    }
    
    // Verificar si el usuario NO es anónimo
    function isNotAnonymous() {
      return request.auth != null && 
             request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    
    // Verificar si es un usuario autenticado (cualquier tipo, incluyendo anónimos)
    function isAuthenticated() {
      return request.auth != null;
    }
    // --- Validaciones de Datos ---
    function isValidString(text) {
      return text is string && text.size() > 0;
    }
    function isValidScore(score) {
      return (score is number && score >= 0 && score <= 100) || score == null;
    }
    function isValidEmail(email) {
      return email is string && email.matches('.*@.*\\..*');
    }
    
    // ===== REGLAS POR COLECCIÓN =====
    
    // USUARIOS: Solo el propio usuario puede leer su perfil, super_admin/rh pueden escribir
    match /users/{userId} {
      allow read: if isAuthenticated() && 
                     (request.auth.uid == userId || hasAnyRole(['super_admin', 'rh']));
      allow create: if hasRole('super_admin');
      allow update: if hasAnyRole(['super_admin', 'rh']) || request.auth.uid == userId;
      allow delete: if hasRole('super_admin');
    }
    
    // EMPLEADOS: Lectura para autenticados, escritura restringida
    // Permite acceso de candidatos (autenticados anónimamente) para login
    match /employees/{docId} {
      // Lectura: Todos los usuarios autenticados (incluye anónimos para portal de candidatos)
      allow read: if isAuthenticated();
      
      // Escritura: Solo super_admin y rh pueden crear/eliminar
      allow create: if hasAnyRole(['super_admin', 'rh'])
                    && isValidString(request.resource.data.name)
                    && isValidString(request.resource.data.employeeId);
      
      // Actualización: Permitir a usuarios autenticados actualizar SOLO campos específicos
      // (para tracking de login de candidatos: accessCodeUses, lastLoginCandidate)
      // ADAPTACIÓN: Se agregan 'cursosCompletados' y 'coursesProgress' para permitir el avance del candidato
      allow update: if hasAnyRole(['super_admin', 'rh']) ||
                       (isAuthenticated() && 
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['accessCodeUses', 'lastLoginCandidate', 'cursosCompletados', 'coursesProgress']));
                          
      allow delete: if hasRole('super_admin');
    }
    
    // CURSOS DE INDUCCIÓN (Nuevo formato)
    match /induction_courses/{docId} {
      // Lectura: Todos los usuarios autenticados (incluye demo y candidatos anónimos)
      allow read: if isAuthenticated();
      
      // Escritura: Solo super_admin y rh
      allow write: if hasAnyRole(['super_admin', 'rh'])
                   && isValidString(request.resource.data.title);
    }
    
    // CURSOS DE INDUCCIÓN (Legacy - cursos_induccion)
    match /cursos_induccion/{docId} {
      allow read: if isAuthenticated();
      allow write: if hasAnyRole(['super_admin', 'rh']);
    }
    
    // POSICIONES/PUESTOS: Candidatos necesitan leer para cargar sus cursos
    match /positions/{docId} {
      allow read: if isAuthenticated();
      allow write: if hasAnyRole(['super_admin', 'rh'])
                   && isValidString(request.resource.data.name);
    }
    
    // TRAINING RECORDS (Legacy - si aún se usa)
    match /training_records/{docId} {
      allow read: if isNotAnonymous();
      allow write: if hasAnyRole(['super_admin', 'rh'])
                   && isValidString(request.resource.data.name) 
                   && isValidString(request.resource.data.position);
    }
    
    // SKILLS ILUO: Solo usuarios no anónimos
    match /skills/{docId} {
      allow read: if isNotAnonymous();
      allow write: if hasAnyRole(['super_admin', 'rh']);
    }
    
    // REGISTROS DE CAPACITACIÓN
    match /training_logs/{docId} {
      allow read: if isNotAnonymous();
      allow write: if hasAnyRole(['super_admin', 'rh']);
    }
    
    // ALERTAS
    match /alerts/{docId} {
      allow read: if isNotAnonymous();
      allow write: if hasAnyRole(['super_admin', 'rh']);
    }
    
    // CALENDARIO
    match /calendar_events/{docId} {
      allow read: if isNotAnonymous();
      allow write: if hasAnyRole(['super_admin', 'rh']);
    }
    
    // PROMOCIONES
    match /promotions/{docId} {
      allow read: if isNotAnonymous();
      allow write: if hasAnyRole(['super_admin', 'rh']);
    }
    
    // AUDITORÍAS/LOGS: Solo super_admin
    match /audit_logs/{docId} {
      allow read, write: if hasRole('super_admin');
    }
    
    // CONFIGURACIÓN DEL SISTEMA: Solo super_admin
    match /system_config/{docId} {
      allow read, write: if hasRole('super_admin');
    }
    
    // ===== REGLA POR DEFECTO (FALLBACK) =====
    // Para cualquier otra colección no especificada
    match /{document=**} {
      allow read: if isNotAnonymous();
      allow write: if hasRole('super_admin');
    }
  }
}
