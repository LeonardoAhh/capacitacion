rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===== FUNCIONES AUXILIARES =====
    
    // Obtener datos del usuario autenticado
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Verificar si el usuario tiene un rol específico
    function hasRole(role) {
       return request.auth != null && getUserData().rol == role;
    }

    // Verificar si el usuario tiene permiso granular para un módulo y una acción
    // Acciones: 'read', 'create', 'update', 'delete'
    // Módulos: 'candidatos', 'capacitacion', 'employees', 'reports', 'dashboard', 'config'
    function hasPermission(module, action) {
      let userData = getUserData();
      return userData.rol == 'super_admin' || 
             (userData.permissions.get(module, {}).get(action, false) == true);
    }
    
    // Verificar si el usuario NO es anónimo
    function isNotAnonymous() {
      return request.auth != null && 
             request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    
    // Verificar si es un usuario autenticado (cualquier tipo)
    function isAuthenticated() {
      return request.auth != null;
    }

    // --- Validaciones de Datos ---
    function isValidString(text) {
      return text is string && text.size() > 0;
    }

    function isValidScore(score) {
      return (score is number && score >= 0 && score <= 100) || score == null;
    }
    
    // ===== REGLAS POR COLECCIÓN =====
    
    // USUARIOS: Super admin gestiona todo. Usuarios leen su propio perfil.
    match /users/{userId} {
      allow read: if isAuthenticated() && 
                     (request.auth.uid == userId || hasPermission('config', 'read'));
      allow create: if hasPermission('config', 'create'); // Solo admins con permiso de config pueden crear
      allow update: if hasPermission('config', 'update') || request.auth.uid == userId; // Propio usuario puede editarse (limitado por frontend) o admin
      allow delete: if hasPermission('config', 'delete');
    }
    
    // EMPLEADOS: Módulo 'employees'
    match /employees/{docId} {
      allow read: if isNotAnonymous() && (hasPermission('employees', 'read') || request.auth.token.email != null); // Permiso basico de lectura para authed
      allow create: if hasPermission('employees', 'create');
      allow update: if hasPermission('employees', 'update');
      allow delete: if hasPermission('employees', 'delete');
    }
    
    // TRAINING RECORDS: Módulo 'capacitacion'
    match /training_records/{docId} {
      allow read: if isNotAnonymous() && hasPermission('capacitacion', 'read');
      allow create: if hasPermission('capacitacion', 'create');
      allow update: if hasPermission('capacitacion', 'update');
      allow delete: if hasPermission('capacitacion', 'delete');
    }
    
    // CURSOS DE INDUCCIÓN: Módulo 'capacitacion' (o 'induction' si se separara) -> Usaremos 'capacitacion'
    match /induction_courses/{docId} {
      allow read: if isAuthenticated(); // Lectura abierta para candidatos
      allow create: if hasPermission('capacitacion', 'create');
      allow update: if hasPermission('capacitacion', 'update');
      allow delete: if hasPermission('capacitacion', 'delete');
    }
    
    // SKILLS ILUO: Módulo 'capacitacion' o 'dashboard'
    match /skills/{docId} {
      allow read: if isNotAnonymous();
      allow create: if hasPermission('capacitacion', 'create');
      allow update: if hasPermission('capacitacion', 'update');
      allow delete: if hasPermission('capacitacion', 'delete');
    }
    
    // POSICIONES/PUESTOS: Módulo 'config'
    match /positions/{docId} {
      allow read: if isNotAnonymous();
      allow create: if hasPermission('config', 'create');
      allow update: if hasPermission('config', 'update');
      allow delete: if hasPermission('config', 'delete');
    }
    
    // REGISTROS DE CAPACITACIÓN (LOGS): Módulo 'capacitacion'
    match /training_logs/{docId} {
      allow read: if isNotAnonymous();
      allow create: if hasPermission('capacitacion', 'create'); // Usualmente creado por sistema
      allow update: if hasPermission('capacitacion', 'update');
      allow delete: if hasPermission('capacitacion', 'delete');
    }
    
    // ALERTAS: Módulo 'dashboard'
    match /alerts/{docId} {
      allow read: if isNotAnonymous();
      allow create: if hasPermission('dashboard', 'create');
      allow update: if hasPermission('dashboard', 'update');
      allow delete: if hasPermission('dashboard', 'delete');
    }
    
    // CALENDARIO: Módulo 'dashboard'
    match /calendar_events/{docId} {
      allow read: if isNotAnonymous();
      allow create: if hasPermission('dashboard', 'create');
      allow update: if hasPermission('dashboard', 'update');
      allow delete: if hasPermission('dashboard', 'delete');
    }
    
    // REPORTES: Módulo 'reports'
    match /promotions/{docId} {
      allow read: if hasPermission('reports', 'read');
      allow create: if hasPermission('reports', 'create');
      allow update: if hasPermission('reports', 'update');
      allow delete: if hasPermission('reports', 'delete');
    }
    
    // CANDIDATOS: Módulo 'candidatos' (Asumiendo colección 'candidates' o 'candidatos')
    match /candidatos/{docId} {
      allow read: if hasPermission('candidatos', 'read');
      allow create: if hasPermission('candidatos', 'create');
      allow update: if hasPermission('candidatos', 'update');
      allow delete: if hasPermission('candidatos', 'delete');
    }

    // AUDITORÍAS/LOGS: Solo super_admin y config
    match /audit_logs/{docId} {
      allow read: if hasPermission('config', 'read');
      allow write: if hasPermission('config', 'create'); // Logs generados por sistema
    }
    
    // CONFIGURACIÓN DEL SISTEMA: Módulo 'config'
    match /system_config/{docId} {
      allow read: if hasPermission('config', 'read');
      allow create: if hasPermission('config', 'create');
      allow update: if hasPermission('config', 'update');
      allow delete: if hasPermission('config', 'delete');
    }
    
    // ===== REGLA POR DEFECTO (FALLBACK) =====
    match /{document=**} {
      allow read: if isNotAnonymous();
      allow write: if hasRole('super_admin');
    }
  }
}
